# Required Azure OpenAI resource and deployment settings
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Required Azure AI Search settings
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX_NAME=travel-kb-index
VECTOR_STORE_TYPE=azure_search

# Optional Azure Content Safety (local guardrails remain enabled without these)
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=

# Optional Azure Storage and Application Insights
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=travel-documents
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Optional MLflow tracking. Set the Azure ML workspace URI (azureml://...); leave blank to disable tracking.
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=wanderlust-travel-chatbot

# Optional maximum number of chunks to ingest; 0 means no limit.
INGESTION_LIMIT=0
